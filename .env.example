PORT=3030
ARCAPTCHA_SITE_KEY=
ARCAPTCHA_SECRET_KEY=
ARCAPTCHA_VERIFY_URL=https://api.arcaptcha.co/arcaptcha/api/verify
ARCAPTCHA_WIDGET_SCRIPT_URL=https://nwidget.arcaptcha.ir/1/api.js
ARCAPTCHA_HEARTBEAT_URL=https://api.arcaptcha.ir/arcaptcha/api/heartbeat
HEARTBEAT_TIMEOUT_MS=3500
HEARTBEAT_POLL_MS=10000
